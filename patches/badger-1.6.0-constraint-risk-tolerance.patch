+    def risk_tolerances(self) -> dict[str, float]:
+        """{constraint: fraction} for the selected constraints whose Risk Tolerance is
+        below 100% (badger-1.6.0-constraint-risk-tolerance); the generator takes these."""
+        tolerances: dict[str, float] = {}
+        for constraint in self.con_table.export_data():
+            name = next(iter(constraint))
