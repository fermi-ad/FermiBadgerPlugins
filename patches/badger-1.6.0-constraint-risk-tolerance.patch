         self.setHorizontalHeaderLabels(
-            ["", "Name", "Relation", "Threshold", "Critical"]
+            ["", "Name", "Relation", "Threshold", "Stopping", "Risk Tolerance"]
         )
+        self.horizontalHeaderItem(4).setToolTip('Stopping: the run stops if a measured value breaks this constraint.')
+        self.horizontalHeaderItem(5).setToolTip("Risk Tolerance: the largest chance, according to the constraint's model, that you accept of a proposed point breaking this constraint. 100% = no limit (the default). 0.01% is the most cautious setting: the model is never certain, so 0 is not possible and becomes 0.01%. If no point meets it, that step ignores it and says so in the log.")
 
