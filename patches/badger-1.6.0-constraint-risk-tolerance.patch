+        risk_spinbox.setValue(info[3] if len(info) > 3 else 100.0)
+        risk_spinbox.setToolTip("Risk Tolerance: the largest chance, according to the constraint's model, that you accept of a proposed point breaking this constraint. 100% = no limit (the default). 0.01% is the most cautious setting: the model is never certain, so 0 is not possible and becomes 0.01%. If no point meets it, that step ignores it and says so in the log.")
+
+        return (relation_combo, threshold_spinbox, critical_checkbox, risk_spinbox)
