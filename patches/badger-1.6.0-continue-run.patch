diff -ruN a/badger/gui/components/continue_run.py b/badger/gui/components/continue_run.py
--- a/badger/gui/components/continue_run.py	1969-12-31 18:00:00
+++ b/badger/gui/components/continue_run.py	2026-10-25 14:55:54
@@ -0,0 +1,326 @@
+"""Continue from a run: start a new run seeded with earlier runs' points.
+
+Shared by both home pages (the action bar's Continue button, and the History
+menu's "Continue from this run" and "Add its points"). The new run is a run of
+its own, with its own archive file; its description names the runs it was
+seeded from. Ranges can be edited (widened) before Go: the model trains on
+every earlier point, inside the new ranges or not.
+
+Only raw readings are archived, so constraint thresholds and directions are
+always those of the new run. What name matching cannot see is an objective or
+observable that kept its name but changed meaning (environment parameters such
+as weights, or formulas); differences there are reported, not refused.
+"""
+
+import json
+import time
+
+import numpy as np
+import pandas as pd
+from PyQt5.QtWidgets import (
+    QCheckBox,
+    QDialog,
+    QDialogButtonBox,
+    QDoubleSpinBox,
+    QHBoxLayout,
+    QLabel,
+    QMessageBox,
+    QTableWidget,
+    QTableWidgetItem,
+    QVBoxLayout,
+)
+
+from badger.errors import BadgerRoutineError
+from badger.gui.utils import MouseWheelWidgetAdjustmentGuard
+
+FORMULA_FIELDS = ("formulas", "constraint_formulas", "observable_formulas")
+
+
+def incompatibility(routine, source):
+    """Why `source`'s points cannot seed `routine` (a composed routine), or None."""
+    if source.data is None or source.data.empty:
+        return "it has no points"
+    was = source.vocs.variable_names + source.vocs.objective_names
+    now = routine.vocs.variable_names + routine.vocs.objective_names
+    if set(was) != set(now):
+        return (
+            "it has other variables or objectives:\n"
+            f" {sorted(was)}\ninstead of\n {sorted(now)}"
+        )
+    missing = [c for c in routine.vocs.constraint_names if c not in source.data]
+    if missing:
+        # Xopt would count its points as violating these: skews TuRBO and EI
+        return f"it did not measure constraint(s) {', '.join(missing)}"
+    return None
+
+
+def _env_params(routine):
+    params = routine.environment.model_dump()
+    params.pop("interface", None)
+    return params
+
+
+def _same(a, b):
+    return json.dumps(a, sort_keys=True, default=str) == json.dumps(
+        b, sort_keys=True, default=str
+    )
+
+
+def differences(routine, source):
+    """What changed that may change what an objective or observable means."""
+    notes = []
+    if source.environment.name != routine.environment.name:
+        notes.append(
+            f"environment {source.environment.name}, not {routine.environment.name}"
+        )
+    else:
+        old, new = _env_params(source), _env_params(routine)
+        for k in sorted(set(old) | set(new)):
+            if not _same(old.get(k), new.get(k)):
+                notes.append(f"{k}: was {old.get(k)!r}, now {new.get(k)!r}")
+    for field in FORMULA_FIELDS:
+        old, new = getattr(source, field) or {}, getattr(routine, field) or {}
+        for k in sorted(set(old) | set(new)):
+            if not _same(old.get(k), new.get(k)):
+                notes.append(f"formula {k} changed")
+    return notes
+
+
+def seed_data(routine, sources, max_age_hours=None, in_ranges=False):
+    """Merged points of `sources` [(name, Routine)] that can seed `routine`.
+
+    Returns (data, report), report being one entry per source:
+    {name, points (kept), skipped (reason or None), notes (differences)}.
+    Points are stacked oldest first and marked as earlier points (live = 0);
+    outputs the new run adds start as NaN columns.
+    """
+    if routine.generator.name in ["neldermead"]:
+        raise BadgerRoutineError(
+            "The neldermead algorithm cannot continue from earlier data.\n"
+            "Pick another algorithm, or start a fresh run."
+        )
+    report, frames = [], []
+    for name, source in sources:
+        entry = {"name": name, "points": 0, "notes": [], "skipped": None}
+        report.append(entry)
+        entry["skipped"] = incompatibility(routine, source)
+        if entry["skipped"]:
+            continue
+        entry["notes"] = differences(routine, source)
+        data = source.data.copy()
+        if max_age_hours is not None and "timestamp" in data:
+            data = data[data["timestamp"] >= time.time() - max_age_hours * 3600]
+        if in_ranges:
+            for var, (lo, hi) in zip(routine.vocs.variable_names, routine.vocs.bounds):
+                data = data[(data[var] >= lo) & (data[var] <= hi)]
+        entry["points"] = len(data)
+        frames.append(data)
+
+    frames = [f for f in frames if not f.empty]
+    if not frames:
+        return None, report
+    data = pd.concat(frames)
+    if "timestamp" in data:
+        data = data.sort_values("timestamp", kind="stable")
+    data = data.reset_index(drop=True)
+    data["live"] = 0  # 0 = an earlier run's point, 1 = measured in this run
+    for name in routine.vocs.output_names:
+        if name not in data.columns:
+            data[name] = np.nan  # observables the new run adds
+    return data, report
+
+
+def fresh_trust_region(routine):
+    """Give a seeded run a new trust region: full size, centred anew.
+
+    Keeps the controller's settings (tolerances, limits, ...) but not its
+    state, so a region the earlier run had shrunk does not carry over; the
+    reassignment rebuilds the controller on the run's own (new) ranges.
+    """
+    # ponytail: `length` goes back to the controller's default, not to a
+    # template's own starting length; keep it here if templates start to set one.
+    tc = getattr(routine.generator, "turbo_controller", None)
+    if tc is None:
+        return
+    routine.generator.turbo_controller = {
+        k: v
+        for k, v in tc.model_dump().items()
+        if k not in ("vocs", "length", "center_x", "best_value")
+    }
+
+
+def drop_seed_note(routine):
+    """Remove a "Seeded with" line copied from the run shown before Go."""
+    if routine.description:
+        lines = routine.description.splitlines()
+        kept = [s for s in lines if not s.startswith("Seeded with ")]
+        routine.description = "\n".join(kept).rstrip() or None
+
+
+def note_source(routine, n_points, names=()):
+    """Record in the run's description where its first points came from."""
+    drop_seed_note(routine)
+    line = f"Seeded with {n_points} points from "
+    line += (", ".join(names) if names else "earlier runs") + "."
+    routine.description = (
+        f"{routine.description.rstrip()}\n{line}" if routine.description else line
+    )
+
+
+class SeedSummaryDialog(QDialog):
+    """Before a run seeded from several runs: what each gives, and filters."""
+
+    def __init__(self, parent, routine, sources):
+        super().__init__(parent)
+        self.setWindowTitle("Seed the run from earlier runs")
+        self.routine, self.sources = routine, sources
+        self.data = None
+
+        vbox = QVBoxLayout(self)
+        self.table = QTableWidget(0, 3)
+        self.table.setHorizontalHeaderLabels(["Run", "Points", "Notes"])
+        self.table.horizontalHeader().setStretchLastSection(True)
+        self.table.setEditTriggers(QTableWidget.NoEditTriggers)
+        vbox.addWidget(self.table)
+
+        row = QHBoxLayout()
+        self.age_check = QCheckBox("Leave out points older than")
+        self.age_hours = QDoubleSpinBox()
+        self.age_hours.setRange(0.1, 24 * 365)
+        self.age_hours.setValue(24)
+        self.age_hours.setSuffix(" h")
+        self.age_hours.installEventFilter(MouseWheelWidgetAdjustmentGuard(self.age_hours))
+        row.addWidget(self.age_check)
+        row.addWidget(self.age_hours)
+        row.addStretch(1)
+        vbox.addLayout(row)
+        self.range_check = QCheckBox("Leave out points outside the new ranges")
+        vbox.addWidget(self.range_check)
+
+        self.total = QLabel()
+        vbox.addWidget(self.total)
+        self.buttons = QDialogButtonBox(QDialogButtonBox.Ok | QDialogButtonBox.Cancel)
+        self.buttons.accepted.connect(self.accept)
+        self.buttons.rejected.connect(self.reject)
+        vbox.addWidget(self.buttons)
+
+        for w in (self.age_check, self.range_check):
+            w.toggled.connect(self.refresh)
+        self.age_hours.valueChanged.connect(self.refresh)
+        self.resize(720, 360)
+        self.refresh()
+
+    def refresh(self):
+        self.data, report = seed_data(
+            self.routine,
+            self.sources,
+            self.age_hours.value() if self.age_check.isChecked() else None,
+            self.range_check.isChecked(),
+        )
+        self.report = report
+        self.table.setRowCount(len(report))
+        for i, e in enumerate(report):
+            points = "skipped" if e["skipped"] else str(e["points"])
+            notes = e["skipped"] or "; ".join(e["notes"])
+            if e["notes"] and not e["skipped"]:
+                notes = "Values may not be comparable: " + notes
+            for j, text in enumerate([e["name"], points, notes]):
+                item = QTableWidgetItem(text)
+                item.setToolTip(text)
+                self.table.setItem(i, j, item)
+        self.table.resizeColumnsToContents()
+        total = sum(len(s.data) for _, s in self.sources if s.data is not None)
+        kept = 0 if self.data is None else len(self.data)
+        self.total.setText(f"Seed with {kept} of {total} points.")
+        self.buttons.button(QDialogButtonBox.Ok).setEnabled(kept > 0)
+
+
+def confirm_seed(parent, routine, sources):
+    """The points to seed `routine` with, or None if the user cancels.
+
+    One source: refused if incompatible, a question if anything that may
+    change values differs. Several: the summary dialog.
+    """
+    if len(sources) == 1:
+        data, report = seed_data(routine, sources)
+        e = report[0]
+        if e["skipped"]:
+            raise BadgerRoutineError(f"Cannot continue from {e['name']}: {e['skipped']}.")
+        if e["notes"]:
+            reply = QMessageBox.question(
+                parent,
+                "Continue from run",
+                f"Since {e['name']}, these changed:\n\n- "
+                + "\n- ".join(e["notes"])
+                + "\n\nIts objective or observable values may not be comparable"
+                " with this run's. Continue anyway?",
+                QMessageBox.Yes | QMessageBox.No,
+                QMessageBox.No,
+            )
+            if reply != QMessageBox.Yes:
+                return None
+        return data
+
+    dialog = SeedSummaryDialog(parent, routine, sources)
+    if dialog.exec_() != QDialog.Accepted:
+        return None
+    return dialog.data
+
+
+class ContinueRun:
+    """Home-page mixin (both GUIs): the Continue button and the runs it seeds from.
+
+    Needs run_action_bar, history_browser, status_bar and current_routine (the
+    shown run, as go_run leaves it); call config_continue() once wired up.
+    """
+
+    def config_continue(self):
+        self.seed_extra = []  # [(name, Routine)] added with "Add its points"
+        self.run_action_bar.btn_continue.toggled.connect(self.continue_toggled)
+        self.history_browser.sig_continue.connect(self.arm_continue)
+        self.history_browser.sig_add_seed.connect(self.add_seed)
+
+    def arm_continue(self):
+        if self.run_action_bar.btn_continue.isEnabled():
+            self.run_action_bar.btn_continue.setChecked(True)
+
+    def continue_toggled(self, checked):
+        if not checked:
+            self.seed_extra = []
+            return
+        self.show_seed_status()
+
+    def seed_sources(self):
+        """[(name, Routine)]: the shown run, then any added ones."""
+        return [(self.history_browser.currentText(), self.current_routine)] + list(
+            self.seed_extra
+        )
+
+    def add_seed(self, name):
+        if not self.run_action_bar.btn_continue.isChecked():
+            QMessageBox.information(
+                self,
+                "Add its points",
+                "First show the run to continue from and press Continue (or"
+                " right-click it: Continue from this run); then add others.",
+            )
+            return
+        if name in [n for n, _ in self.seed_sources()]:
+            return
+        from badger.archive import get_base_run_filename, load_run
+
+        try:
+            routine = load_run(get_base_run_filename(name))
+        except Exception as e:
+            QMessageBox.warning(self, "Add its points", f"Cannot load {name}:\n{e}")
+            return
+        self.seed_extra.append((name, routine))
+        self.show_seed_status()
+
+    def show_seed_status(self):
+        sources = self.seed_sources()
+        msg = f"Go will continue from {sources[0][0]}: a new run seeded with its points"
+        if len(sources) > 1:
+            n = sum(len(s.data) for _, s in sources if s.data is not None)
+            msg += f", and {len(sources) - 1} more run(s) ({n} points in all)"
+        self.status_bar.set_summary(msg + ". Widen ranges first if needed.")
