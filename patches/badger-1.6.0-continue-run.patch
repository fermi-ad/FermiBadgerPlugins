diff -ruN a/badger/gui/components/continue_run.py b/badger/gui/components/continue_run.py
--- a/badger/gui/components/continue_run.py	1969-12-31 18:00:00
+++ b/badger/gui/components/continue_run.py	2026-10-24 09:36:24
@@ -0,0 +1,76 @@
+"""Continue from a run: start a new run seeded with an earlier run's points.
+
+Shared by both home pages (the action bar's Continue button and the History
+menu's "Continue from this run"). The new run is a run of its own, with its
+own archive file; its description names the run it continued from. Ranges
+can be edited (widened) before Go: the model trains on every earlier point,
+inside the new ranges or not.
+"""
+
+import numpy as np
+
+from badger.errors import BadgerRoutineError
+
+
+def seed_data(routine, source, init_points_flag=False):
+    """The source run's points, ready to seed `routine` (a composed routine).
+
+    Variables and objectives must match the source run's by name; new
+    constraints or observables start as empty (NaN) columns, which need
+    initial points to fill them.
+    """
+    if routine.generator.name in ["neldermead"]:
+        raise BadgerRoutineError(
+            "The neldermead algorithm cannot continue from earlier data.\n"
+            "Pick another algorithm, or start a fresh run."
+        )
+    if source.data is None or source.data.empty:
+        raise BadgerRoutineError("The run to continue from has no points.")
+
+    was = source.vocs.variable_names + source.vocs.objective_names
+    now = routine.vocs.variable_names + routine.vocs.objective_names
+    if set(was) != set(now):
+        raise BadgerRoutineError(
+            "Can only continue with the same variables and objectives.\n\n"
+            f"The earlier run has:\n {was}\n\nThis run has:\n {now}"
+        )
+
+    data = source.data.copy()
+    data["live"] = 0  # 0 = an earlier run's point, 1 = measured in this run
+    for name in routine.vocs.output_names:
+        if name not in data.columns:
+            data[name] = np.nan
+    if data.isna().all().any() and not init_points_flag:
+        raise BadgerRoutineError(
+            "This run adds constraints or observables the earlier run did not"
+            " measure.\nAdd at least one initial point, or remove them."
+        )
+    return data
+
+
+def fresh_trust_region(routine):
+    """Give a seeded run a new trust region: full size, centred anew.
+
+    Keeps the controller's settings (tolerances, limits, ...) but not its
+    state, so a region the earlier run had shrunk does not carry over; the
+    reassignment rebuilds the controller on the run's own (new) ranges.
+    """
+    # ponytail: `length` goes back to the controller's default, not to a
+    # template's own starting length; keep it here if templates start to set one.
+    tc = getattr(routine.generator, "turbo_controller", None)
+    if tc is None:
+        return
+    routine.generator.turbo_controller = {
+        k: v
+        for k, v in tc.model_dump().items()
+        if k not in ("vocs", "length", "center_x", "best_value")
+    }
+
+
+def note_source(routine, n_points, source_name=None):
+    """Record in the run's description where its first points came from."""
+    line = f"Seeded with {n_points} points"
+    line += f" from {source_name}." if source_name else " from earlier runs."
+    routine.description = (
+        f"{routine.description.rstrip()}\n{line}" if routine.description else line
+    )
