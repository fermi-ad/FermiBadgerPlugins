+class DeviceGroupsDialog(QDialog):
+    """Edit a parameter made of device groups, each with its own number(s):
+    mults ({name: {step, members: {device: scale}}}) or bulk power supplies
+    ({group: {limit or positive + negative, devices: [...]}}). Each group shows
+    the number fields it has. Members are picked from the environment's
+    settable devices. Groups can't be added or renamed here: the environment
+    class declares a variable or observable for each."""
+
+    def __init__(self, title: str, note: str, groups: dict[str, dict[str, float]],
+                 numbers: dict[str, dict[str, float]], number_labels: dict[str, str],
+                 devices: list[str], with_scale: bool, group_label=lambda name: name,
+                 parent: QWidget | None = None):
+        super().__init__(parent)
+        self.devices = devices
+        self.with_scale = with_scale
+        self.result: tuple[dict[str, dict[str, float]], dict[str, dict[str, float]]] | None = None
+        self.setWindowTitle(title)
+        self.resize(560, 520)
+        layout = QVBoxLayout(self)
+        label = QLabel(note)
+        label.setWordWrap(True)
+        layout.addWidget(label)
+        # Several groups (four bulk supplies in RIL) scroll; each table is
+        # sized to its own rows rather than squeezed to share the height.
+        scroll = QScrollArea()
+        scroll.setWidgetResizable(True)
+        inner = QWidget()
+        groups_layout = QVBoxLayout(inner)
+        scroll.setWidget(inner)
+        layout.addWidget(scroll, 1)
+        self.sections: dict[str, tuple[dict[str, QDoubleSpinBox], QTableWidget]] = {}
+        for name, members in groups.items():
+            box = QGroupBox(group_label(name))
+            vbox = QVBoxLayout(box)
+            row = QHBoxLayout()
+            spins: dict[str, QDoubleSpinBox] = {}
+            for key, label in number_labels.items():  # the fields this group has
+                if key not in numbers[name]:
+                    continue
+                row.addWidget(QLabel(label))
+                spin = QDoubleSpinBox()
+                spin.setDecimals(4)
+                spin.setRange(0.0001, 1e6)
+                spin.setValue(float(numbers[name][key]))
+                spin.installEventFilter(MouseWheelWidgetAdjustmentGuard(spin))
+                row.addWidget(spin)
+                row.addSpacing(12)
+                spins[key] = spin
+            row.addStretch()
+            vbox.addLayout(row)
+            number = spins.get("step")
+            headers = ["Device", "Scale", "Per step"] if with_scale else ["Device"]
+            table = QTableWidget(0, len(headers))
+            table.setHorizontalHeaderLabels(headers)
+            table.horizontalHeader().setSectionResizeMode(0, QHeaderView.ResizeMode.Stretch)
+            table.verticalHeader().setVisible(False)
+            vbox.addWidget(table)
+            buttons = QHBoxLayout()
+            add = QPushButton("Add member")
+            add.clicked.connect(lambda _=False, n=name: self.add_member(n, "", 1.0))
+            remove = QPushButton("Remove member")
+            remove.clicked.connect(lambda _=False, t=table: self._remove_selected(t))
+            buttons.addWidget(add)
+            buttons.addWidget(remove)
+            buttons.addStretch()
+            vbox.addLayout(buttons)
+            groups_layout.addWidget(box)
+            self.sections[name] = (spins, table)
+            if number is not None:
+                number.valueChanged.connect(lambda _=0.0, n=name: self._update_per_step(n))
+            for device, scale in members.items():
+                self.add_member(name, device, scale)
+            self._fit(table)
+        groups_layout.addStretch()
+        box = QDialogButtonBox(QDialogButtonBox.Ok | QDialogButtonBox.Cancel)
+        box.accepted.connect(self.accept)
+        box.rejected.connect(self.reject)
+        layout.addWidget(box)
+
+    def add_member(self, name: str, device: str, scale: float = 1.0) -> None:
+        _, table = self.sections[name]
+        row = table.rowCount()
+        table.insertRow(row)
+        table.setCellWidget(row, 0, _device_combo(self.devices, device, editable=not self.devices))
+        if self.with_scale:
+            spin = QDoubleSpinBox()
+            spin.setDecimals(4)
+            spin.setRange(-1e6, 1e6)
+            spin.setValue(float(scale))
+            spin.installEventFilter(MouseWheelWidgetAdjustmentGuard(spin))
+            spin.valueChanged.connect(lambda _=0.0, n=name: self._update_per_step(n))
+            table.setCellWidget(row, 1, spin)
+            item = QTableWidgetItem()
+            item.setFlags(Qt.ItemFlag.ItemIsEnabled)
+            table.setItem(row, 2, item)
+            self._update_per_step(name)
+        self._fit(table)
+
+    @staticmethod
+    def _fit(table: QTableWidget) -> None:
+        """Show every member row, plus room for one more."""
+        rows = table.verticalHeader().defaultSectionSize() * (table.rowCount() + 1)
+        table.setFixedHeight(table.horizontalHeader().sizeHint().height() + rows
+                             + 2 * table.frameWidth())
+
+    def _remove_selected(self, table: QTableWidget) -> None:
+        rows = {i.row() for i in table.selectedIndexes()} or {table.currentRow()}
+        for row in sorted((r for r in rows if r >= 0), reverse=True):
+            table.removeRow(row)
+        self._fit(table)
+
+    def _update_per_step(self, name: str) -> None:
+        spins, table = self.sections[name]
+        if not self.with_scale or "step" not in spins:
+            return
+        for row in range(table.rowCount()):
+            scale = table.cellWidget(row, 1).value()
+            table.item(row, 2).setText(f"{scale * spins['step'].value():g}")
+
+    def values(self) -> tuple[dict[str, dict[str, float]], dict[str, dict[str, float]], list[str]]:
+        """({group: {device: scale}}, {group: {number key: value}}, problems)."""
+        groups: dict[str, dict[str, float]] = {}
+        numbers: dict[str, dict[str, float]] = {}
+        problems: list[str] = []
+        for name, (spins, table) in self.sections.items():
+            members: dict[str, float] = {}
+            for row in range(table.rowCount()):
+                device = table.cellWidget(row, 0).currentText().strip()
+                if not device:
+                    problems.append(f"{name}: member {row + 1} has no device.")
+                    continue
+                if device in members:
+                    problems.append(f"{name}: {device} is listed twice.")
+                    continue
+                members[device] = table.cellWidget(row, 1).value() if self.with_scale else 1.0
+            if not members:
+                problems.append(f"{name}: needs at least one member.")
+            groups[name] = members
+            numbers[name] = {key: spin.value() for key, spin in spins.items()}
+        return groups, numbers, problems
+
+    def accept(self) -> None:
+        groups, numbers, problems = self.values()
+        if problems:
+            QMessageBox.warning(self, self.windowTitle(),
+                                "Please fix these first:\n\n" + "\n".join(problems))
+            return
+        self.result = (groups, numbers)
+        super().accept()
+
