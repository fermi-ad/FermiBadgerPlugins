+def _parse_cell(text: str) -> Any:
+    """A table cell as YAML would read it: 1.2 -> 1.2, hold -> 'hold', '' -> None."""
+    text = text.strip()
+    if text == "" or text in ("None", "null"):
+        return None
+    try:
+        return yaml.load(text, Loader=CustomSafeLoader)
+    except yaml.YAMLError:
+        return text
+
+
+def _mapping_to_text(mapping: dict[str, Any]) -> str:
+    """One line of YAML, in the given order, quoting whatever needs it."""
+    return yaml.dump(mapping, default_flow_style=True, sort_keys=False, width=10**6).strip()
+
+
+def _device_combo(names: list[str], current: str = "", editable: bool = True) -> QComboBox:
+    """A pulldown of device names; editable ones also take typing, completing
+    from the same list."""
+    combo = QComboBox()
+    combo.setEditable(editable)
+    combo.addItems(names)
+    combo.installEventFilter(MouseWheelWidgetAdjustmentGuard(combo))
+    if editable:
+        completer = QCompleter(names, combo)
+        completer.setCaseSensitivity(Qt.CaseSensitivity.CaseInsensitive)
+        completer.setFilterMode(Qt.MatchFlag.MatchContains)
+        combo.setCompleter(completer)
+    if current and combo.findText(current) < 0:
+        combo.addItem(current)  # not one the environment declares: keep it visible
+    combo.setCurrentText(current) if editable else combo.setCurrentIndex(combo.findText(current))
+    return combo
+
+
+class _CompleterDelegate(QStyledItemDelegate):
+    """Name cells: a pulldown of the environment's own device names, which also
+    accepts any other name typed in (e.g. 'default' in sample_events)."""
+
+    def __init__(self, names: list[str], parent: QWidget | None = None):
+        super().__init__(parent)
+        self.names = names
+
+    def createEditor(self, parent, option, index):  # noqa: N802 (Qt API)
+        if not self.names:
+            return super().createEditor(parent, option, index)
+        combo = _device_combo(self.names)
+        combo.setParent(parent)
+        return combo
+
+    def setEditorData(self, editor, index):  # noqa: N802 (Qt API)
+        if isinstance(editor, QComboBox):
+            editor.setCurrentText(index.data() or "")
+        else:
+            super().setEditorData(editor, index)
+
+    def setModelData(self, editor, model, index):  # noqa: N802 (Qt API)
+        if isinstance(editor, QComboBox):
+            model.setData(index, editor.currentText().strip())
+        else:
+            super().setModelData(editor, model, index)
