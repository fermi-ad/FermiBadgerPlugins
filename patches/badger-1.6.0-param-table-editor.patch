+def _parse_cell(text: str) -> Any:
+    """A table cell as YAML would read it: 1.2 -> 1.2, hold -> 'hold', '' -> None."""
+    text = text.strip()
+    if text == "" or text in ("None", "null"):
+        return None
+    try:
+        return yaml.load(text, Loader=CustomSafeLoader)
+    except yaml.YAMLError:
+        return text
+
+
+def _mapping_to_text(mapping: dict[str, Any]) -> str:
+    """One line of YAML, in the given order, quoting whatever needs it."""
+    return yaml.dump(mapping, default_flow_style=True, sort_keys=False, width=10**6).strip()
+
+
+class _CompleterDelegate(QStyledItemDelegate):
+    """Name cells complete from the environment's own device names."""
+
+    def __init__(self, names: list[str], parent: QWidget | None = None):
+        super().__init__(parent)
+        self.names = names
+
+    def createEditor(self, parent, option, index):  # noqa: N802 (Qt API)
+        editor = super().createEditor(parent, option, index)
+        if isinstance(editor, QLineEdit) and self.names:
+            completer = QCompleter(self.names, editor)
+            completer.setCaseSensitivity(Qt.CaseSensitivity.CaseInsensitive)
+            completer.setFilterMode(Qt.MatchFlag.MatchContains)
+            editor.setCompleter(completer)
+        return editor
+
