+    def _add_table_button(self, name: str, line: QLineEdit, example: dict[str, Any]) -> None:
+        """An Edit... button inside the field's right edge opens it as a table.
+        The line keeps holding the YAML text, which is what gets saved."""
+        button = QToolButton(line)
+        button.setText("Edit...")
+        button.setToolTip(f"Edit {name} as a table")
+        button.setCursor(Qt.CursorShape.PointingHandCursor)
+        button.adjustSize()
+        line.setTextMargins(0, 0, button.width() + 4, 0)
+        line.installEventFilter(_EditButtonPlacer(line, button))
+        button.clicked.connect(lambda: self.edit_as_table(name, line, example))
+        line.edit_button = button  # for tests
+
+    def edit_as_table(self, name: str, line: QLineEdit, example: dict[str, Any]) -> None:
+        note = ""
+        if check_dict_text(line.text(), example) is None:
+            current = yaml.load(
+                line.text().replace(": None", ": null").replace(", None", ", null"),
+                Loader=CustomSafeLoader,
+            ) or {}
+        else:
+            current = dict(example)
+            note = ("The text in this field has an error, so the table starts from "
+                    "the template's values. OK replaces the text.")
+        dialog = MappingTableDialog(name, current, example, _environment_names(self),
+                                    note, self)
+        self.table_dialog = dialog  # for tests
+        if dialog.exec_() == QDialog.Accepted and dialog.result_mapping is not None:
+            line.setText(_mapping_to_text(dialog.result_mapping))
+
