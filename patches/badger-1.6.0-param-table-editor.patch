+class _EditButtonPlacer(QObject):
+    """Keeps an Edit... button at the right edge inside its line edit."""
+
+    def __init__(self, line: QLineEdit, button: QToolButton):
+        super().__init__(line)
+        self.line, self.button = line, button
+
+    def eventFilter(self, obj, event):  # noqa: N802 (Qt API)
+        if event.type() in (QEvent.Type.Resize, QEvent.Type.Show):
+            h = self.line.height() - 4
+            self.button.setFixedHeight(max(h, 16))
+            self.button.move(self.line.width() - self.button.width() - 2, 2)
+        return False
+
+
+def _environment_names(widget: QWidget) -> list[str]:
+    """Device names the environment declares, for completing table keys:
+    variables, observables, and the readings behind '-SETPOINT' observables.
+    Found on the routine page that holds this editor (both GUIs keep the
+    environment class as `env`)."""
+    while widget is not None:
+        env = getattr(widget, "env", None)
+        if env is not None and hasattr(env, "observables"):
+            names = list(getattr(env, "variables", {}) or {})
+            observables = list(getattr(env, "observables", []) or [])
+            names += observables
+            names += [o[: -len("-SETPOINT")] for o in observables if o.endswith("-SETPOINT")]
+            return sorted(set(names))
+        widget = widget.parent()
+    return []
+
