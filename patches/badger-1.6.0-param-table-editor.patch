+def _environment_settings(widget: QWidget) -> list[str]:
+    """The environment's settable devices (its variables, minus the mult:
+    knobs and read/set pairs), for picking mult members."""
+    while widget is not None:
+        env = getattr(widget, "env", None)
+        if env is not None and hasattr(env, "observables"):
+            return [n for n in (getattr(env, "variables", {}) or {})
+                    if not n.startswith("mult:") and "," not in n]
+        widget = widget.parent()
+    return []
+
