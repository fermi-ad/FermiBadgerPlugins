+# Context variables (FermiBadgerPlugins patch badger-1.6.0-context-variables): a variable
+# checked in the variable table's Context column is an Xopt ContextualVariable. Badger never
+# writes it; its value is read at every step, and the model uses it as an input.
+def context_names(vocs) -> list[str]:
+    from xopt.vocs import ContextualVariable
+
+    return [n for n, v in vocs.variables.items() if isinstance(v, ContextualVariable)]
+
+
+def settable_vocs(vocs):
+    """The VOCS without its context variables (current and random initial points)."""
+    ctx = set(context_names(vocs))
+    if not ctx:
+        return vocs
+    return vocs.model_copy(
+        update={"variables": {n: v for n, v in vocs.variables.items() if n not in ctx}}
+    )
