+def widened(variable, value):
+    """A context variable whose domain takes in `value`, a reading outside its range (the
+    expected span), or the variable itself if the value is inside or not a number."""
+    from xopt.vocs import ContextualVariable
+
+    try:
+        value = float(value)
+    except (TypeError, ValueError):
+        return variable
+    lo, hi = variable.domain
+    if value != value or lo <= value <= hi:  # NaN, or inside
+        return variable
+    return ContextualVariable(domain=[min(lo, value), max(hi, value)])
