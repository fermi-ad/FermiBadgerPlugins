     # Show the main window
     window = BadgerMainWindow()
+
+    def load_template_at_launch():
+        # Same as the -mini GUI: the name is relative to BADGER_TEMPLATE_ROOT. Runs once the
+        # event loop is up, so a failure (e.g. the live-range read with no control network)
+        # shows the usual error dialog instead of killing the process before the window exists.
+        try:
+            template_dir = config_singleton.read_value("BADGER_TEMPLATE_ROOT")
