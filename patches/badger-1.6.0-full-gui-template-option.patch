+            logger.warning(
+                f"Template directory not configured. File {template_filename} was not loaded"
+            )
+            return
+        window.home_page.routine_editor.load_template_yaml(
+            False, template_path=os.path.join(template_dir, template_filename)
+        )
+
+    if template_filename:
+        QtCore.QTimer.singleShot(0, load_template_at_launch)
 
