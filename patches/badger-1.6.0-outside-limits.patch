diff -ruN a/badger/gui/components/outside_limits.py b/badger/gui/components/outside_limits.py
--- a/badger/gui/components/outside_limits.py	1969-12-31 18:00:00
+++ b/badger/gui/components/outside_limits.py	2026-10-26 20:33:30
@@ -0,0 +1,74 @@
+"""Variables whose current value lies outside their hard limits, e.g. a supply
+left at standby during a shutdown (the RIL source solenoids at 50 A, limits
+300-500 A, 2026-10-26).
+
+Such a variable cannot be tuned from where it is. A window of "current value
+± delta" clipped to the limits has no width, which Xopt rejects (it used to
+crash the template load); any other window would make BO's first step a jump
+from far outside the limits. Both routine pages therefore untick these
+variables, say which and why, and leave them out of the run until the device
+is back within its limits.
+"""
+
+import logging
+
+from PyQt5.QtWidgets import QMessageBox
+
+logger = logging.getLogger(__name__)
+
+
+def hard_limits(page):
+    """{variable: [lo, hi]}: the environment's limits, or the routine's override."""
+    limits = {}
+    for var in page.env_box.var_table.variables:
+        name = next(iter(var))
+        limits[name] = (page.var_hard_limit or {}).get(name, var[name])
+    return limits
+
+
+def is_outside(value, limits):
+    return not limits[0] <= value <= limits[1]
+
+
+def untick_outside_limits(page, values, at_go=False):
+    """Untick the checked variables whose value in `values` is outside its hard
+    limits, and say so; returns {name: (value, limits)} of those unticked."""
+    table = page.env_box.var_table
+    limits = hard_limits(page)
+    bad = {
+        n: (v, limits[n])
+        for n, v in values.items()
+        if n in limits and table.is_checked(n) and is_outside(v, limits[n])
+    }
+    if not bad:
+        return bad
+    table.set_selected([n for n, on in table.selected.items() if on and n not in bad])
+    lines = "\n".join(
+        f"  {n}: reads {v:g}, limits {lo:g} to {hi:g}" for n, (v, (lo, hi)) in bad.items()
+    )
+    QMessageBox.warning(
+        page,
+        "Variables outside their limits",
+        "These variables read outside their limits, so they cannot be tuned from"
+        f" where they are, and have been unticked:\n\n{lines}\n\n"
+        "Is the machine in its tuning state? Tick them again once they are back"
+        " within their limits."
+        + ("\n\nGo was cancelled: check the variables and press Go again." if at_go else ""),
+    )
+    return bad
+
+
+def check_at_go(page):
+    """Before a run: read the checked variables now; False (Go cancelled) if any
+    is outside its limits, after unticking it."""
+    names = [n for n, on in page.env_box.var_table.selected.items() if on]
+    if not names:
+        return True
+    try:
+        values = page.create_env().get_variables(names)
+    except Exception:
+        # Can't read: not this check's call. The settings snapshot at Go asks
+        # about it, and the run's own reads report it.
+        logger.warning("Limits check at Go skipped: could not read the variables", exc_info=True)
+        return True
+    return not untick_outside_limits(page, values, at_go=True)
