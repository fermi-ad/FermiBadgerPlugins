+def _value_kind(value: Any) -> str:
+    if value is None:
+        return "nothing"
+    if isinstance(value, bool):
+        return "true/false"
+    if isinstance(value, (int, float)):
+        return "a number"
+    return "text"
+
+
+def check_dict_text(text: str, example: dict[str, Any]) -> str | None:
+    """Why `text` is not a usable `{name: value, ...}` mapping like `example`
+    (the template's own value for the field), or None if it is.
+
+    The values may be of the kinds `example` holds; text also admits numbers
+    (e.g. a setpoint that is either a number or 'hold')."""
+    try:
+        value = yaml.load(
+            text.replace(": None", ": null").replace(", None", ", null"),
+            Loader=CustomSafeLoader,
+        )
+    except yaml.YAMLError as e:
+        where = ""
+        mark = getattr(e, "problem_mark", None)
+        if mark is not None:
+            where = f" (near character {mark.column + 1})"
+        problem = getattr(e, "problem", None) or "cannot be read"
+        return (
+            f"Not a valid {{name: value, ...}} list: {problem}{where}. "
+            "Check the braces, colons and commas."
+        )
+    if not isinstance(value, dict):
+        return "Must be a {name: value, ...} list in braces."
+    allowed = {_value_kind(v) for v in example.values()}
+    if "text" in allowed:
+        allowed.add("a number")
+    for name, v in value.items():
+        kind = _value_kind(v)
+        if not allowed or kind in allowed:
+            continue
+        if kind == "nothing":
+            return f"'{name}' has no value: is a ':' missing after it?"
+        return f"'{name}': expected {' or '.join(sorted(allowed))}, not {v!r}."
+    return None
+
+
+def parameter_problems(widget: QWidget) -> list[str]:
+    """Problems in every parameter editor inside `widget` (both GUIs' routine
+    pages), as 'name: why' lines; empty when all can be used."""
+    problems: list[str] = []
+    for editor in widget.findChildren(BadgerPydanticEditor):
+        problems += editor.check_text_fields()
+    return problems
+
+
