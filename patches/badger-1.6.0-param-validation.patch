+    def check_text_fields(self) -> list[str]:
+        """Check each dict-valued field edited as text (environment parameters
+        arrive as a plain dict, so a dict value, or a string holding one, is
+        shown as one line of YAML). The text at load time, or the field's
+        default, is the example of what the field holds. Marks each bad field
+        red with the reason as its tooltip; returns 'name: reason' lines."""
+        problems: list[str] = []
+        if self.model_class is None:
+            return problems
+        if getattr(self, "_examples_for", None) is not self.model_class:
+            self._examples_for, self._examples = self.model_class, {}
+        for name, field in self.model_class.model_fields.items():
+            if field.annotation is not str:
+                continue
+            items = self.findItems(name, Qt.MatchFlag.MatchExactly, 0)
+            widget = self.itemWidget(items[0], self.value_col) if items else None
+            if not isinstance(widget, QLineEdit):
+                continue
+            if name not in self._examples:  # first look: the loaded value
+                source = field.default if isinstance(field.default, str) else widget.text()
+                example = None
+                if source.lstrip().startswith("{"):
+                    try:
+                        example = yaml.load(source, Loader=CustomSafeLoader)
+                    except yaml.YAMLError:
+                        pass
+                    if not isinstance(example, dict):
+                        example = {}
+                self._examples[name] = example
+            example = self._examples[name]
+            if example is None:  # not a mapping: plain text
+                continue
+            reason = check_dict_text(widget.text(), example)
+            if reason:
+                self.update_error_styles((name,), reason)
+                problems.append(f"{name}: {reason}")
+        return problems
+
