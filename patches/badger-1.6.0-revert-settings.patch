diff -ruN a/badger/gui/components/settings_guard.py b/badger/gui/components/settings_guard.py
--- a/badger/gui/components/settings_guard.py	1969-12-31 18:00:00
+++ b/badger/gui/components/settings_guard.py	2026-10-21 21:04:23
@@ -0,0 +1,228 @@
+"""Startup-settings snapshot, Revert and the Keep/Revert question on close, shared
+by the mini and full GUI home pages (FermiBadgerPlugins,
+badger-1.6.0-revert-settings.patch).
+
+The pacsys work is FermiBadgerPlugins' plugins/settings_snapshot.py, importable
+because Badger puts BADGER_PLUGIN_ROOT on sys.path. safe_badger.py in that repo
+is the launcher that restores automatically if Badger is interrupted.
+
+The home page using this mixin must provide routine_editor, run_action_bar,
+run_monitor and status_bar.
+"""
+
+import html
+import logging
+import os
+
+from PyQt5.QtCore import Qt
+from PyQt5.QtGui import QFontDatabase
+from PyQt5.QtWidgets import QApplication, QMessageBox
+
+from badger.utils import load_config
+
+logger = logging.getLogger(__name__)
+
+
+class SettingsGuard:
+    # --- capture -------------------------------------------------------------------
+
+    def _capture(self, template=None) -> int:
+        """Snapshot the current environment's writable devices (first-seen wins).
+        Returns how many devices the snapshot holds; raises if they can't be read."""
+        editor = self.routine_editor
+        env_cls = editor.env
+        if env_cls is None:
+            return 0
+        env_box = editor.env_box
+        params_editor = getattr(env_box, "edit_env_params", None) or env_box.edit
+        params = load_config(params_editor.get_parameters_yaml()) or {}
+        field = env_cls.model_fields.get("settings_role")
+        role = params.get("settings_role", field.default if field else None)
+        import settings_snapshot
+
+        QApplication.setOverrideCursor(Qt.WaitCursor)
+        try:
+            count = settings_snapshot.capture(env_cls.variables, role, template=template)
+        finally:
+            QApplication.restoreOverrideCursor()
+        self.run_action_bar.revert_ready = self.run_action_bar.revert_ready or count > 0
+        if not self.run_monitor.running:
+            self.run_action_bar.btn_revert.setEnabled(self.run_action_bar.revert_ready)
+        return count
+
+    def snapshot_settings(self, info):
+        """On every template load: record the live setting of every device the
+        environment can write, checked or not, and say how long the automatic
+        restore covers."""
+        template = info.split(": ", 1)[-1]
+        try:
+            count = self._capture(template)
+        except Exception as e:
+            logger.exception("Settings snapshot failed")
+            QMessageBox.warning(
+                self,
+                "No settings snapshot",
+                f"Could not record the current device settings for {template}:\n\n{e}"
+                "\n\nRevert, and the automatic restore if Badger is interrupted, "
+                "will not cover this template's devices.",
+            )
+            return
+        if count:
+            import settings_snapshot
+
+            if os.environ.get("FERMIBADGER_LAUNCHER_PID"):
+                data = settings_snapshot.load(settings_snapshot.session_path())
+                until = settings_snapshot.auto_restore_until(data)
+                note = f"automatic restore if interrupted until {until:%H:%M}"
+            else:
+                note = "NO automatic restore (not started with safe-badger)"
+            self.status_bar.set_summary(
+                f"{template}: startup settings of {count} devices saved; {note}"
+            )
+
+    def snapshot_at_go(self) -> bool:
+        """Before a run writes anything: snapshot the environment as it is now, which
+        covers an environment chosen without loading a template. False: don't run."""
+        try:
+            self._capture()
+            return True
+        except Exception as e:
+            logger.exception("Settings snapshot at Go failed")
+            reply = QMessageBox.warning(
+                self,
+                "No settings snapshot",
+                f"Could not record the current device settings:\n\n{e}\n\n"
+                "Without it, neither Revert nor the automatic restore can put "
+                "this run's changes back. Start the run anyway?",
+                QMessageBox.Yes | QMessageBox.No,
+                QMessageBox.No,
+            )
+            return reply == QMessageBox.Yes
+
+    # --- compare / restore -----------------------------------------------------------
+
+    def _settings_changes(self):
+        """(snapshot module, path, [(device, startup, now)]) or None if there is no
+        snapshot to compare with. Raises if the live settings can't be read."""
+        try:
+            import settings_snapshot
+        except ImportError:  # plugin root not on the path: no snapshot was taken
+            return None
+        path = settings_snapshot.session_path()
+        if not path.exists():
+            return None
+        QApplication.setOverrideCursor(Qt.WaitCursor)
+        try:
+            return settings_snapshot, path, settings_snapshot.diff(path)
+        finally:
+            QApplication.restoreOverrideCursor()
+
+    def _changes_box(self, title, snap, path, changes):
+        """A question box listing the changed devices as a fixed-width table, so
+        the columns of numbers line up."""
+        box = QMessageBox(QMessageBox.Question, title, "", parent=self)
+        box.setTextFormat(Qt.RichText)
+        # Named, not left to Qt: its fixed-font lookups can return proportional fonts.
+        installed = QFontDatabase().families()
+        mono = next(
+            (f for f in ("DejaVu Sans Mono", "Liberation Mono", "Menlo", "Courier New")
+             if f in installed),
+            QFontDatabase.systemFont(QFontDatabase.FixedFont).family(),
+        )
+        box.setText(
+            f"{len(changes)} device(s) differ from their settings when the template "
+            f"was loaded ({snap.age(snap.load(path))} ago):"
+            f"<pre style=\"font-family: '{mono}'\">"
+            f"{html.escape(snap.format_changes(changes))}</pre>"
+        )
+        return box
+
+    def _restore_settings(self, snap, path):
+        """Write the snapshot back; True if every device now matches it."""
+        QApplication.setOverrideCursor(Qt.WaitCursor)
+        try:
+            failed = snap.restore(path)
+        except Exception as e:
+            failed = [f"(restore aborted: {e})"]
+        finally:
+            QApplication.restoreOverrideCursor()
+        refresh = getattr(
+            self.routine_editor.env_box.var_table, "refresh_current_values", None
+        )
+        if refresh:  # the mini GUI's table shows live values; the full GUI's doesn't
+            try:
+                refresh()
+            except Exception:
+                logger.exception("Could not refresh the variable table after restore")
+        if failed:
+            QMessageBox.critical(
+                self,
+                "Revert incomplete",
+                "These devices still differ from their startup settings:\n\n"
+                + "\n".join(failed)
+                + f"\n\nTo retry from a terminal: pixi run safe-badger restore {path}",
+            )
+        return not failed
+
+    # --- Revert button / closing -------------------------------------------------------
+
+    def revert_settings(self):
+        if self.run_monitor.running:
+            return
+        try:
+            found = self._settings_changes()
+        except Exception as e:
+            QMessageBox.critical(self, "Revert", f"Could not read device settings:\n\n{e}")
+            return
+        if found is None:
+            return
+        snap, path, changes = found
+        if not changes:
+            QMessageBox.information(
+                self, "Revert", "Every device is already at its startup setting."
+            )
+            return
+        box = self._changes_box("Revert all devices", snap, path, changes)
+        box.setInformativeText("Revert them all to their startup settings?")
+        box.setStandardButtons(QMessageBox.Yes | QMessageBox.No)
+        box.setDefaultButton(QMessageBox.No)
+        box.exec_()
+        if box.clickedButton() is box.button(QMessageBox.Yes):
+            self._restore_settings(snap, path)
+
+    def settle_settings(self) -> bool:
+        """On close, Keep or Revert what this session changed and record the choice
+        (an undecided snapshot is restored by safe-badger). False: stay open."""
+        try:
+            found = self._settings_changes()
+        except Exception as e:
+            reply = QMessageBox.warning(
+                self,
+                "Close Badger",
+                f"Could not read device settings to compare with startup:\n\n{e}"
+                "\n\nClose anyway? If Badger was started with 'pixi run safe-badger', "
+                "it will try to restore every device.",
+                QMessageBox.Yes | QMessageBox.No,
+                QMessageBox.No,
+            )
+            return reply == QMessageBox.Yes
+        if found is None:
+            return True
+        snap, path, changes = found
+        if not changes:
+            snap.resolve(path, "keep")
+            return True
+        box = self._changes_box("Close Badger", snap, path, changes)
+        box.setInformativeText("Keep the new settings, or revert to the startup ones?")
+        btn_keep = box.addButton("Keep", QMessageBox.AcceptRole)
+        btn_revert = box.addButton("Revert", QMessageBox.DestructiveRole)
+        box.addButton(QMessageBox.Cancel)
+        box.setDefaultButton(QMessageBox.Cancel)
+        box.exec_()
+        if box.clickedButton() is btn_keep:
+            snap.resolve(path, "keep")
+            return True
+        if box.clickedButton() is btn_revert and self._restore_settings(snap, path):
+            snap.resolve(path, "reverted")
+            return True
+        return False
