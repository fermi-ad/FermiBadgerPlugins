+    @staticmethod
+    def _panel_heading(title: str) -> QLabel:
+        """Heading on a parameters panel's docs row. Never widens the panel:
+        a long environment name is clipped, with the full text in the tooltip."""
+        label = QLabel()
+        label.setTextFormat(Qt.RichText)
+        label.setSizePolicy(QSizePolicy.Ignored, QSizePolicy.Preferred)
+        BadgerEnvBox._set_panel_heading(label, title, "")
+        return label
