diff -ruN a/xopt/generators/bayesian/noise_shape.py b/xopt/generators/bayesian/noise_shape.py
--- a/xopt/generators/bayesian/noise_shape.py	1969-12-31 18:00:00
+++ b/xopt/generators/bayesian/noise_shape.py	2026-11-19 17:09:39
@@ -0,0 +1,142 @@
+"""Non-Gaussian measurement noise for the measured-value risk tolerance
+(FermiBadgerPlugins patch xopt-3.2.2-noise-shapes).
+
+A constraint's noise shape is a GaussExp: a Gaussian core with an exponential tail beyond
+kL sigmas below and kR sigmas above, matched in value and slope at both splices. Only the
+shape comes from here (a device's noise profile, fitted to logged readings); the noise's
+size comes from the constraint's own GP. A fresh reading is the GP's latent value f plus
+noise sigma_n * e, e the shape standardized to mean 0 and variance 1, and
+
+    P(reading < bound) = E_f[ P(e < (bound - f) / sigma_n) ]
+
+computed by quadrature over whichever of f and e has the larger spread (the integrand is
+then smooth in the integration variable): Gauss-Hermite over f when the latent spread
+s <= sigma_n, otherwise over e (Gauss-Legendre on the core, Gauss-Laguerre on each
+exponential tail). With no shape, the noise is Gaussian: Phi((bound - mean) / sqrt(s^2 +
+sigma_n^2)).
+
+Also: leave-one-out residuals of an exact GP, to check a run's own noise against a
+profile's shape (staleness), by an Anderson-Darling test of the residuals against the
+shape's cdf. In an offline check (one variable; 20 seeds each; 10 % of readings 10 noise
+sigmas high) it flagged all 20 runs of 80 points and none of 20 clean runs, but none of
+20 spiky runs of 30 points: little power in short runs.
+"""
+import math
+
+import numpy as np
+import torch
+from scipy import optimize, stats
+
+K_MIN, K_MAX = 0.1, 8.0  # splices, in sigmas: below 0.1 no core is left; beyond 8, no tail
+AD_CRITICAL_1PCT = 3.857  # Anderson-Darling A^2, fully specified null: p = 0.01
+N_HERMITE, N_LEGENDRE, N_LAGUERRE = 48, 48, 24
+
+
+def _unit_constants(kl, kr):
+    """Normalization, mean, and standard deviation of the unit GaussExp(kL, kR)."""
+    el, er = math.exp(-kl ** 2 / 2), math.exp(-kr ** 2 / 2)
+    core = math.sqrt(2 * math.pi) * (stats.norm.cdf(kr) - stats.norm.cdf(-kl))
+    n = core + el / kl + er / kr
+    m1 = -el / kl ** 2 + er / kr ** 2
+    m2 = core + el * (2 / kl + 2 / kl ** 3) + er * (2 / kr + 2 / kr ** 3)
+    mean = m1 / n
+    return n, mean, math.sqrt(m2 / n - mean ** 2)
+
+
+class NoiseShape:
+    """A GaussExp noise shape, standardized: mean 0, variance 1."""
+
+    def __init__(self, kl: float, kr: float):
+        self.kl = min(max(float(kl), K_MIN), K_MAX)
+        self.kr = min(max(float(kr), K_MIN), K_MAX)
+        self.norm, self.mean, self.std = _unit_constants(self.kl, self.kr)
+        # quadrature over the unit GaussExp Z: nodes z and weights (summing to 1)
+        kl, kr, n = self.kl, self.kr, self.norm
+        x, w = np.polynomial.legendre.leggauss(N_LEGENDRE)
+        z_core = (kr - kl) / 2 + (kr + kl) / 2 * x
+        w_core = (kr + kl) / 2 * w * np.exp(-z_core ** 2 / 2) / n
+        t, wt = np.polynomial.laguerre.laggauss(N_LAGUERRE)
+        z_left, w_left = -kl - t / kl, wt * math.exp(-kl ** 2 / 2) / (n * kl)
+        z_right, w_right = kr + t / kr, wt * math.exp(-kr ** 2 / 2) / (n * kr)
+        self._z = np.concatenate([z_left, z_core, z_right])
+        self._wz = np.concatenate([w_left, w_core, w_right])
+        self._xh, self._wh = np.polynomial.hermite.hermgauss(N_HERMITE)
+        e = (self._z - self.mean) / self.std
+        self.excess_kurtosis = float(np.sum(self._wz * e ** 4) - 3.0)
+
+    def cdf_unit(self, z: torch.Tensor) -> torch.Tensor:
+        """P(Z < z) for the unit GaussExp (not standardized)."""
+        kl, kr, n = self.kl, self.kr, self.norm
+        left = torch.exp(kl ** 2 / 2 + kl * torch.clamp(z, max=-kl)) / kl
+        core = math.exp(-kl ** 2 / 2) / kl + math.sqrt(2 * math.pi) * (
+            _phi_cdf(torch.clamp(z, -kl, kr)) - stats.norm.cdf(-kl))
+        right = n - torch.exp(kr ** 2 / 2 - kr * torch.clamp(z, min=kr)) / kr
+        return torch.where(z < -kl, left, torch.where(z > kr, right, core)) / n
+
+    def cdf(self, e: torch.Tensor) -> torch.Tensor:
+        """P(noise < e) for the standardized shape."""
+        return self.cdf_unit(self.mean + self.std * e)
+
+    def ppf(self, p: float) -> float:
+        """Quantile of the standardized shape (for checks; numpy, not differentiable)."""
+        f = lambda e: float(self.cdf(torch.tensor(e, dtype=torch.double))) - p  # noqa: E731
+        return optimize.brentq(f, -1e3, 1e3)
+
+    def p_below(self, bound, mean, s, sigma_n):
+        """P(f + sigma_n e < bound), f ~ N(mean, s^2), e this shape: tensors broadcast."""
+        dtype, device = mean.dtype, mean.device
+        # over f (Gauss-Hermite), for s <= sigma_n
+        xh = torch.as_tensor(self._xh, dtype=dtype, device=device)
+        wh = torch.as_tensor(self._wh, dtype=dtype, device=device) / math.sqrt(math.pi)
+        f = mean.unsqueeze(-1) + math.sqrt(2) * s.unsqueeze(-1) * xh
+        p_f = (wh * self.cdf((bound - f) / sigma_n.unsqueeze(-1))).sum(-1)
+        # over the noise (Legendre core + Laguerre tails), for s > sigma_n
+        z = torch.as_tensor(self._z, dtype=dtype, device=device)
+        wz = torch.as_tensor(self._wz, dtype=dtype, device=device)
+        e = (z - self.mean) / self.std
+        arg = (bound - mean.unsqueeze(-1) - sigma_n.unsqueeze(-1) * e) / s.unsqueeze(-1)
+        p_e = (wz * _phi_cdf(arg)).sum(-1)
+        return torch.where(s <= sigma_n, p_f, p_e)
+
+
+def _phi_cdf(x):
+    return 0.5 * torch.erfc(-x / math.sqrt(2))
+
+
+def p_below(bound, mean, s, sigma_n, shape=None):
+    """P(a fresh reading < bound): latent f ~ N(mean, s^2) plus noise of size sigma_n,
+    Gaussian when shape is None."""
+    if shape is None:
+        return _phi_cdf((bound - mean) / torch.sqrt(s ** 2 + sigma_n ** 2))
+    return shape.p_below(bound, mean, s, sigma_n)
+
+
+def loo_residuals(gp) -> np.ndarray:
+    """Leave-one-out standardized residuals of an exact GP's training data, in closed
+    form: (K^-1 r)_i / sqrt((K^-1)_ii), K the prior covariance plus the likelihood's
+    noise at the training inputs, r the training targets minus the prior mean (both as
+    the marginal likelihood sees them)."""
+    was_training = gp.training
+    gp.train()
+    try:
+        with torch.no_grad():
+            inputs = gp.train_inputs
+            marginal = gp.likelihood(gp(*inputs), *inputs)
+            K = marginal.covariance_matrix
+            r = (gp.train_targets - marginal.mean).unsqueeze(-1)
+            K_inv = torch.cholesky_inverse(torch.linalg.cholesky(K))
+            z = (K_inv @ r).squeeze(-1) / K_inv.diagonal(dim1=-2, dim2=-1).sqrt()
+    finally:
+        gp.train(was_training)
+    return z.detach().cpu().numpy().ravel()
+
+
+def shape_check(z: np.ndarray, shape: NoiseShape):
+    """Anderson-Darling A^2 of the residuals z against the standardized shape (> 3.857:
+    p < 0.01), and the residuals' excess kurtosis, to compare with the shape's
+    (shape.excess_kurtosis): higher means heavier tails than the shape says."""
+    u = shape.cdf(torch.as_tensor(np.sort(z), dtype=torch.double)).numpy()
+    u = np.clip(u, 1e-12, 1 - 1e-12)
+    n, i = len(u), np.arange(1, len(u) + 1)
+    a2 = -n - np.mean((2 * i - 1) * (np.log(u) + np.log(1 - u[::-1])))
+    return float(a2), float(stats.kurtosis(z))
