+        # Handle case where special_item_dict is a string (just the class name)
+        # e.g., turbo_controller: OptimizeTurboController
+        # Convert to dict with name key
+        if isinstance(special_item_dict_raw, str):
+            special_item_dict: dict[str, Any] = {"name": special_item_dict_raw}
+        elif special_item_dict_raw is None:
