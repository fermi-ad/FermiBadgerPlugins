+    def _risk_limits(self):
+        """[(output index, bound, sign, 1 - tolerance)] for the constraints with a risk
+        tolerance below 1 (none while a step ignores them)."""
+        if not self.constraint_risk_tolerance or self._risk_off:
+            return []
+        names = list(self.model_output_names)
+        limits = []
+        for name, tolerance in self.constraint_risk_tolerance.items():
+            if tolerance >= 1.0:
+                continue
+            if name not in self.vocs.constraints:
+                logger.warning("Risk tolerance for %r ignored: not a constraint", name)
+                continue
+            constraint = self.vocs.constraints[name]
+            sign = 1.0 if type(constraint).__name__ == "LessThanConstraint" else -1.0
+            limits.append((names.index(name), float(constraint.value), sign, 1.0 - tolerance))
+        return limits
+
+    def _apply_risk_tolerance(self, acq, model):
+        limits = self._risk_limits()
+        return RiskLimitedAcquisition(acq, model, limits) if limits else acq
