 logger = logging.getLogger()
 
+
+# Risk tolerance (FermiBadgerPlugins patch xopt-3.2.2-constraint-risk-tolerance):
+# the largest modeled probability an operator accepts that a proposed point violates
+# a constraint. A point whose probability of satisfying a constraint is below
+# 1 - tolerance is penalized in the acquisition; tolerances clamp to [1e-4, 1].
+RISK_TOLERANCE_MIN = 1e-4
+RISK_PENALTY = 1e3  # per unit of probability shortfall; dwarfs (log-)acquisition spreads
+
+
+def risk_shortfall(model, X: Tensor, limits) -> Tensor:
+    """Sum over the limited constraints of max(0, (1 - tolerance) - P(satisfied)) at each
+    point of X (batch x q x d), from the constraint model's posterior mean and spread.
+    limits: [(output index, bound, +1 for less-than or -1 for greater-than, 1 - tolerance)]."""
+    posterior = model.posterior(X)
+    mean, sigma = posterior.mean, posterior.variance.clamp_min(1e-12).sqrt()
+    normal = torch.distributions.Normal(
+        torch.zeros((), dtype=mean.dtype, device=mean.device),
+        torch.ones((), dtype=mean.dtype, device=mean.device),
+    )
+    shortfall = torch.zeros(mean.shape[:-1], dtype=mean.dtype, device=mean.device)
+    for index, bound, sign, needed in limits:
+        p_ok = normal.cdf(sign * (bound - mean[..., index]) / sigma[..., index])
+        shortfall = shortfall + torch.relu(needed - p_ok)
+    return shortfall
+
+
+class RiskLimitedAcquisition(AcquisitionFunction):
+    """An acquisition function minus a steep penalty wherever a point's modeled
+    probability of satisfying a constraint is below 1 - its risk tolerance."""
+
+    def __init__(self, acq: AcquisitionFunction, model, limits):
+        super().__init__(model=model)
+        self.acq = acq
+        self.limits = limits
+
+    def forward(self, X: Tensor) -> Tensor:
+        return self.acq(X) - RISK_PENALTY * risk_shortfall(self.model, X, self.limits).sum(-1)
+
+
