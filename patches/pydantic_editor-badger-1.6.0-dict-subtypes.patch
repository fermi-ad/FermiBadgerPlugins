+        # For dict types without subtypes, store as YAML strings.
+        # This avoids the "Dict type must have subtypes" error while still
+        # allowing dict values from templates to be displayed and edited.
+        field_definitions: dict[str, tuple[type, FieldInfo]] = {}
+        for k, v in params.items():
+            if isinstance(v, dict):
+                # Store dict as YAML string; pydantic_editor will parse it back
+                # Use flow style (inline {}) to match template format and ensure
+                # the default check in _set_params_recurse works correctly
+                yaml_str = yaml.dump(v, default_flow_style=True).strip()
+                field_definitions[k] = (str, Field(default=yaml_str))
+            elif isinstance(v, list):
+                # For lists, use list[str] if all items are strings, otherwise list[float]
+                # This ensures the list has proper subtypes for pydantic_editor
+                if all(isinstance(item, str) for item in v):
+                    field_definitions[k] = (list[str], Field())
+                elif all(isinstance(item, (int, float)) for item in v):
+                    field_definitions[k] = (list[float], Field())
+                else:
+                    field_definitions[k] = (list, Field())
+            else:
+                field_definitions[k] = (type(v), Field())
+
         if field_definitions == {}:
             logger.warning("No fields found in params dictionary")
             return
