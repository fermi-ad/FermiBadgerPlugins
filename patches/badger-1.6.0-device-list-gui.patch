diff -ruN a/badger/gui/components/picker.py b/badger/gui/components/picker.py
--- a/badger/gui/components/picker.py	1969-12-31 18:00:00
+++ b/badger/gui/components/picker.py	2026-10-07 14:24:30
@@ -0,0 +1,85 @@
+"""Search-and-pick combo box for adding an item to a table.
+
+An editable QComboBox whose dropdown lists the names the given ``source``
+callable returns as ``(name, checked)`` pairs, in table order, with a check
+icon on the ones already selected. The list opens as soon as the box gets
+focus, narrows by substring as you type, and closes when focus leaves.
+Choosing an entry emits ``picked(name)`` and clears the box. The list is
+rebuilt every time the box gains focus or opens, so no signal wiring is needed.
+"""
+
+from typing import Callable
+
+from PyQt5.QtCore import QEvent, Qt, QTimer, pyqtSignal
+from PyQt5.QtGui import QIcon
+from PyQt5.QtWidgets import QComboBox, QCompleter, QStyle
+
+
+class Picker(QComboBox):
+    picked = pyqtSignal(str)
+
+    def __init__(self, source: Callable[[], list[tuple[str, bool]]], placeholder: str = ""):
+        super().__init__()
+        self._source = source
+        self._check = self.style().standardIcon(QStyle.StandardPixmap.SP_DialogApplyButton)
+        self.setEditable(True)
+        self.setInsertPolicy(QComboBox.InsertPolicy.NoInsert)
+        self.lineEdit().setPlaceholderText(placeholder)
+        completer = QCompleter(self.model(), self)
+        completer.setCompletionMode(QCompleter.CompletionMode.PopupCompletion)
+        completer.setFilterMode(Qt.MatchFlag.MatchContains)
+        completer.setCaseSensitivity(Qt.CaseSensitivity.CaseInsensitive)
+        self.setCompleter(completer)
+        self.setCurrentIndex(-1)
+        self.lineEdit().installEventFilter(self)  # a click opens the list even if already focused
+        self.activated[str].connect(self._pick)
+        completer.activated[str].connect(self._pick)  # harmless if both fire: _pick is idempotent
+
+    def refresh(self):
+        self.blockSignals(True)
+        super().clear()
+        for name, checked in self._source():
+            self.addItem(self._check if checked else QIcon(), name)
+        self.setCurrentIndex(-1)
+        self.blockSignals(False)
+
+    def showPopup(self):
+        self.refresh()
+        self.view().setMinimumWidth(self.view().sizeHintForColumn(0) + 24)
+        super().showPopup()
+
+    USER_FOCUS = (
+        Qt.FocusReason.MouseFocusReason,
+        Qt.FocusReason.TabFocusReason,
+        Qt.FocusReason.BacktabFocusReason,
+    )
+
+    def focusInEvent(self, event):
+        self.refresh()
+        super().focusInEvent(event)
+        # Only a click or Tab opens the list. Focus also comes back with
+        # PopupFocusReason each time the popup closes; opening on that reopens it forever.
+        if event.reason() in self.USER_FOCUS:
+            QTimer.singleShot(0, self._open_list)
+
+    def eventFilter(self, obj, event):
+        if obj is self.lineEdit() and event.type() == QEvent.Type.MouseButtonPress:
+            QTimer.singleShot(0, self._open_list)
+        return super().eventFilter(obj, event)
+
+    def _open_list(self):
+        if not self.hasFocus():
+            return
+        completer = self.completer()
+        completer.setCompletionPrefix(self.currentText())
+        completer.complete()  # popup of all matches; closes itself when focus leaves
+
+    def clear(self):  # routine pages call edit_*.clear(); only clear the text
+        self.clearEditText()
+        self.setCurrentIndex(-1)
+
+    def _pick(self, name: str):
+        if name in dict(self._source()):
+            self.picked.emit(name)
+        self.clear()
+        self.completer().popup().hide()
