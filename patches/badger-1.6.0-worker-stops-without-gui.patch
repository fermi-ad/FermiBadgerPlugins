+def _exit_if_gui_gone(gui_pid: int) -> None:
+    """End this run worker at once if the GUI that started it is gone (killed or
+    crashed): nobody is left to watch the run, stop it, or receive its results,
+    so it must not set another point. Without this a worker outlived its GUI:
+    the spare waited forever, and a running one carried on, or blocked forever
+    sending results to the dead GUI."""
+    if os.getppid() != gui_pid:  # re-parented: the GUI exited
+        os._exit(0)
+
+
+def _watch_gui(gui_pid: int) -> None:
+    """Check every second, whatever the worker is doing (waiting for a run,
+    paused, fitting, blocked sending results), that its GUI is still there."""
+
+    def watch():
+        while True:
+            time.sleep(1.0)
+            _exit_if_gui_gone(gui_pid)
+
+    threading.Thread(target=watch, name="gui-watchdog", daemon=True).start()
+
+
