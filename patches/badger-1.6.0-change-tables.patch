@@ -23,6 +23,30 @@
 logger = logging.getLogger(__name__)
 
 
+def mono_family():
+    """A fixed-width font family. Named, not left to Qt: its fixed-font lookups can return
+    proportional fonts."""
+    installed = QFontDatabase().families()
+    return next(
+        (f for f in ("DejaVu Sans Mono", "Liberation Mono", "Menlo", "Courier New")
+         if f in installed),
+        QFontDatabase.systemFont(QFontDatabase.FixedFont).family(),
+    )
+
+
+def table_question(parent, title, intro, table):
+    """A Yes/No question box (No by default): intro, then a fixed-width table
+    (settings_snapshot.format_changes), so its columns line up
+    (badger-1.6.0-change-tables)."""
+    box = QMessageBox(QMessageBox.Question, title, "", parent=parent)
+    box.setTextFormat(Qt.RichText)
+    box.setText(f"{html.escape(intro)}<pre style=\"font-family: '{mono_family()}'\">"
+                f"{html.escape(table)}</pre>")
+    box.setStandardButtons(QMessageBox.Yes | QMessageBox.No)
+    box.setDefaultButton(QMessageBox.No)
+    return box
+
+
 class SettingsGuard:
