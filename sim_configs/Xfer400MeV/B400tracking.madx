OBSERVE, PLACE=BPHQ3;
!OBSERVE, PLACE=VMV0;
!OBSERVE, PLACE=HMH1;
!OBSERVE, PLACE=SM_MW02;
!OBSERVE, PLACE=HHTQ04;
!OBSERVE, PLACE=VVTQ04;
OBSERVE, PLACE=BPHQ4;
!OBSERVE, PLACE=VMV1;
!OBSERVE, PLACE=SM_MW03;
!OBSERVE, PLACE=HHTQ05;
!OBSERVE, PLACE=VVTQ05;
OBSERVE, PLACE=BPHQ5;
!OBSERVE, PLACE=HHTQ06;
!OBSERVE, PLACE=VVTQ06;
OBSERVE, PLACE=BPHQ6;
!OBSERVE, PLACE=SM_MW04;
!OBSERVE, PLACE=HHTQ07;
!OBSERVE, PLACE=VVTQ07;
OBSERVE, PLACE=BPHQ7;
!OBSERVE, PLACE=SM_MW05;
!OBSERVE, PLACE=HHTQ08;
!OBSERVE, PLACE=VVTQ08;
OBSERVE, PLACE=BPHQ8;
OBSERVE, PLACE=BPHQ9;
OBSERVE, PLACE=BPHQ10;
OBSERVE, PLACE=BPHQ11;
!OBSERVE, PLACE=SM_MW06;
!OBSERVE, PLACE=HHTMV2;
!OBSERVE, PLACE=VVTMV2;
!OBSERVE, PLACE=VMV2;
!OBSERVE, PLACE=SM_MW07;
!OBSERVE, PLACE=HHTQ12;
!OBSERVE, PLACE=VVTQ12;
OBSERVE, PLACE=BPHQ12;
!OBSERVE, PLACE=HHTDEB;
!OBSERVE, PLACE=VVTDEB;
OBSERVE, PLACE=BPHDEB;
!OBSERVE, PLACE=SM_MW08;
!OBSERVE, PLACE=DEBUNCHER;
!OBSERVE, PLACE=SM_MW09;
!OBSERVE, PLACE=HHTQ13;
!OBSERVE, PLACE=VVTQ13;
OBSERVE, PLACE=BPHQ13;
!OBSERVE, PLACE=HMH21;
!OBSERVE, PLACE=HMH22;
!OBSERVE, PLACE=HHTQ14;
!OBSERVE, PLACE=VVTQ14;
OBSERVE, PLACE=BPHQ14;
OBSERVE, PLACE=BPHQ15;
!OBSERVE, PLACE=BPVQ15;
OBSERVE, PLACE=BPHQ16;
!OBSERVE, PLACE=BPVQ16;
OBSERVE, PLACE=BPHQ17;
!OBSERVE, PLACE=BPVQ17;
!OBSERVE, PLACE=SM_MW10;
!OBSERVE, PLACE=SM_MW11;
!OBSERVE, PLACE=SM_MW12;
!OBSERVE, PLACE=HHTINJ1;
!OBSERVE, PLACE=VVTINJ1;
OBSERVE, PLACE=BPHINJ;
!OBSERVE, PLACE=BPVINJ;
OBSERVE, PLACE=HORB2;
!-----------------------------------------------------------------


!you can make maxaper as large as needed to ensure you don't have losses if the beam is too large.
RUN, TURNS=1;!, MAXAPER=real array, FFILE=integer, KEEPTRACK=logical;

endtrack;


stop;
