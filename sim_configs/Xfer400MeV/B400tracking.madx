!
!       Setting variables
!
!-------------------------------------------------------------------------------

title, 'What he heck is going on....';
DEG_TO_RAD      := 3.141592654 / 180.0;
ekin            := 0.4000000;
erest           := 0.9382800;
c               := 0.2997925;
etotal          := ekin+erest;                      ! 1.338
pc              := sqrt(etotal*etotal-erest*erest); ! 0.9542
gamma           := etotal/erest;                    ! 1.426
beta            := sqrt(1-(1/(gamma*gamma)));       ! 0.713
brho            := pc/c;                            ! 3.184

l_trim          := 0.2508;    ! quad trim correctors lenght: 9 7/8 in
l_bpm_reg       := 0.188;     ! bpms length:             7 3/8 in
l_bpm_lam	:= 0.155;     ! bpm length for lam
l_rw            := 0.0508;    ! running wires lenght:        2     in
l_mw            := 0.3302;    ! MW can diameter:             13    in <- D. Choo
l_tor           := 0.0699;    ! Tor length:                  2 3/4 in
l_bv            := 0.062;     ! Beam valve:                  2 5/8 in
!
! Quadrupoles - Physical Length
!
!l_quad_LL       := 0.254;    
!l_quad_TA       := 0.254;    
!l_quad_TB       := 0.254;    
!l_quad_Q74      := 0.07;
!
! Quadrupoles - Effective Length and Quad Strength
!
l_quad_LL       := 0.2906;   ! Harding's meas. in spare LQL  (red)   (01/29/2004)
l_quad_TA       := 0.2854;   ! Harding's meas. in spare TQTA (square)(02/09/2004)
l_quad_TB       := 0.2956;   ! Harding's meas. in spare TQTB (oval)  (02/08/2004)
l_quad_Q74      := 0.0853;   ! Ref. T. Kroc
c_quad_Q74      := 0.1343;   ! [T/m-A] Ref. T. Kroc
!c_quad_Q74      := 0.157;   ! [T/m-A] Ref. M. Popovic (03/14/05)
!c_quad_Q74      := 0.0672;  ! [T/m-A] Ref. T. Kroc
c_quad_LL       := 0.053097; ! [T/m-A] Harding's meas. in spare LQL  (01/29/2004)
c_quad_TB       := 0.178518; ! [T/m-A] Harding's meas. in spare TQTB (02/08/2004)

delta74 := 0.0853*0.4;

!
! Dipoles - Physical Length
!
l_chop          := 1.3825;    ! Add 0.0235m each side for round plates
!l_lam           := 0.849325;  ! Lamination. With the plates, add 0.174 each side
!l_mv0           := 0.4681;
!l_mh1           := 1.2192;    ! Gap=8.255 cm (3.25")
!l_mv1           := 1.0668;    ! Gap=9.525 cm (3.75")
!l_mv2           := 1.0668;    ! Gap=9.525 cm (3.75")
!l_mh2           := 1.2192;    ! Gap=8.255 cm (3.25")
!l_dcsep         := 1.2827;    ! Gap=3.78 cm  (1.4882")
!l_orbmp         := 0.483;     ! This value came from Booster lattice
!
! Dipoles - Effective Length
!
