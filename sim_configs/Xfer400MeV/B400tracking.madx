!-------------------------------------------------------------------------------
lmisc0    : line=(dtrw1us,dtrw1ds,dtchop,CHOPPER,dtrw2us,dtrw2ds,dttor1us,
                  dttor1ds,dtrwmus,dtrwmds);

lmisc0_1  : line=(dtcor1us,dtcor1ds,dtcor2us,dtcor2ds,dtstus,dtstds,dtrw4us,
                  dtrw4ds);

mw0_1     : line=(L400Start,ltq1,lmisc0,ltq2,dtrw3us,dtrw3ds,dtQ2us,Q2,lbpq2,
                  lmisc0_1,lbplam,dtLAMus,llam,dtmw01us);

mw1_2     : line=(SM_MW01,dtmw01ds,dtbv01us,dtbv01ds,ltq3,dtQ3us,Q3,lbpq3,
                  dtMV0us,lmv0,dtMH1us,lmh1,dttor2us,dttor2ds,dtmw02us);

mw2_3     : line=(SM_MW02,dtmw02ds,ltq4,dtQ4us,Q4,lbpq4,dtMV1us,lmv1,dtmw03us);

mw3_4     : line=(SM_MW03,dtmw03ds,dtbv02us,dtbv02ds,ltq5,dtQ5us,Q5,lbpq5,
                  dtshieldus);

mw4_5     : line=(lbpq6,dtQ6us,Q6,ltq6,dtmw04us,SM_MW04,dtmw04ds,ltq7,dtQ7us,Q7,lbpq7,dtmw05us);

mw5_6     : line=(SM_MW05,dtmw05ds,lbpq8,dtQ8us,Q8,ltq8,dtmw06us);

!mw6_7     : line=(SM_MW06,dtmw06ds,ltmv2,dtMV2us,lmv2,lbpq9,dtQ9us,Q9,dtQ10us,
!                  Q10,lbpq10,dtQ11us,Q11,lbpq11,dtmw07us);

!mw7_8     : line=(SM_MW07,dtmw07ds,lbpq12,dtQ12us,Q12,ltq12,dtpickupus,
!                  dtpickupds,ltdeb,dtmw08us);

mw6_7     : line=(SM_MW06,dtmw06ds,ltmv2,dtMV2us,lmv2,lbpq9,dtQ9us,Q9,dtmw07us);

mw7_8     : line=(SM_MW07,dtmw07ds,dtQ10us,Q10,lbpq10,dtQ11us,Q11,lbpq11,
                  lbpq12,dtQ12us,Q12,ltq12,dtSORBPus,dtSORBPds,ltdeb,dtmw08us);

mw8_9     : line=(SM_MW08,dtmw08ds,lbpdeb,dtDEBbv,dtDEBus,DEBUNCHER,dtmw09us);

mw9_10    : line=(SM_MW09,dtmw09ds,ltq13,dtQ13us,Q13,lbpq13,dtmh21us,
                  lmh21);

mw10_11   : line=(dtmh22us,lmh22,ltq14,lbpq14,dtQ14us,Q14,lbpq15,dtQ15us,
                  Q15,dtmw10us,SM_MW10,dtmw10ds,dturbop,&
                  lbpq16,dtQ16us,Q16,dtmw11us);

mw11_12   : line=(SM_MW11,dtmw11ds,dtordcs,lbpq17,dtQ17us,Q17,dtmw12us);

girder    : line=(SM_MW12,dtmw12ds,dtbvinj,ltinj1,ltinj2,lbpinj,dtorb2,
                  lorb2,dtfoil);

l400mev   : line=(mw0_1,mw1_2,mw2_3,mw3_4,mw4_5,mw5_6,mw6_7,mw7_8,
                  mw8_9,mw9_10,mw10_11,mw11_12,girder);

energy    : line=(mw0_1,mw1_2,mw2_3,mw3_4);

!-------------------------------------------------------------------------------
!
! PRINTING OPTICS FILE
!
!-------------------------------------------------------------------------------
!emittance for madx is pi 10e-3 mrad, so pimmmrad is 10^3 normally
!HOWEVER units for beam is in m 4e-6 may well be correct
!i think they use 1 sigma now as the emittance definition, rather than the epsilon=4epsilon_{rms}
!check to make sure it give a reasonable beam size
!I think 4e-6 is correct however
emitVal=4.0E-6;

BEAM,     particle=proton, energy=etotal, EX=emitVal, EY=emitVal, sigt=1;
USE, sequence=l400mev;

SELECT, flag=twiss, column=name,s,k1,BETX,ALFX,DX,dpx,MUX,BETY,ALFY,MUY,DY,dpy,X,Y;
TWISS, BETX = 1.113092, ALFX = -0.89649, BETY = 5.6787, ALFY = 0.49047, file=optics_400mev.dat, sectormap;

TWISS,    betx= BETAX, alfx= ALPHAX, dx= DISPX, dpx= DISPPX, 
          bety= BETAY, alfy= ALPHAY, dy= DISPY, dpy= DISPPY, 
          SAVE= "NewInjection", TAPE= "400.TWS";


!PLOT,     HAXIS= s, VAXIS1= betx,bety VAXIS2= dx,dy, 
!          HMIN= 0, HMAX= 70, VMIN= 0,-5 VMAX= 100,+5, 
!          TITLE= "Booster 400MeV Beamline Beta Function", 
!          COLOUR= 100;
PLOT,     HAXIS= s, VAXIS1= X, VAXIS2= Y, 
          HMIN= 0, HMAX= 70, VMIN= -0.01,-0.01 VMAX= +0.01,0.01, 
          TITLE= "Booster 400MeV Beamline Transverse", 
          COLOUR= 100;

!--------
!TRACK
!--------

!Particle Tracking using TRACK module

!Note: I believe the x and and y in the twiss is the distance from reference orbit to closed orbit orbit. Since this is a linac without
!closed orbit I believe these values default to zero.

!this probably isn't needed but I feel better reitializing the beam just in case the sequence was modified prior.
BEAM,     particle=proton, energy=etotal, EX=emitVal, EY=emitVal, sigt=1;
USE, sequence=l400mev;

!beam sigma truncation
gaussSigma = 4;
number_particles=1;

!This is a single turn so we don't need to find a closed orbit or go crazy with tracking (feel free to change around if it needs to be more exact)
!I am currently assuming that since this is a single turn and such we don't need to go too crazy with tracking modules and such

!To use the TRACK module, thick lenses such as bends need to be simplified into thin lenses
!You can specify the number of thin individually per element, see the track module in the user guide for more information

makethin, sequence=1400mev,style=teapot;makedipedge=false;
!initialization of track module
!no aperture in the default version
!IMPORTANT: If an RF cavity has a non-zero voltage, synchrotron oscillations are automatically included.
!If tracking with constant momentum is desired, then the voltage of the RF
!cavities has to be set to zero. If an RF cavity has a no zero voltage and DELTAP is non zero,
!tracking is done with synchrotron oscillations around an off-momentum closed orbit.

!DUMP logical will add extra outputs, but is easier to parse, so it may be useful to you.
TRACK, DELTAP=0.0, ONEPASS=true, DUMP=false, ONETABLE=true, file=l400mevtrackone;


while(n<number_particles){
!we need to populate the distribution based on the given optics functions
!since we have our emittance and other optics, it'll be easiest to create this in terms of rms of beam size.
!fx is rms beam size so we know that the beam is guassian ie e^-x^2+px^2/ e^Fx

!Uses the same random seed every run, if necessary manually change seed for different runs
!TGAUSS(x) random number, gaussian distribution with unit standard deviation, truncated at x standard deviations
!tguass gives the standard deviation of the guassian action (x^2+px^2)
!sqrt turns it the the proper amplitude
!action is in terms of amplitude, not traditional action it looks like from the documentation
!amp = sqrt(abs(TGAUSS(gaussSigma)));
inampx = TGAUSS(gaussSigma);
inphix = pi*ranf();
inampy = TGAUSS(gaussSigma);
inphiy = pi*ranf();
!START, FX=inampx, PHIX=inphix, FY=inampy, PHIY=inphiy,FT=0, PHIT=0;
!START, X=0.0, PX=0.0, Y=0.0, PY=0.01,T=0.0, PT=0.0;
START, X=TMPX, PX=TMPPX, Y=TMPY, PY=TMPPY,T=0.0, PT=0.0;
n=n+1;
}
!--------------
!name of the observation point, if memory serves if nothing is here you just get the end of the bunch
!add a list of many observation points currently only using monitor elements
!OBSERVE, PLACE=string;
!OBSERVE, PLACE=L400Start;
!OBSERVE, PLACE=HHTQ01;	      
!OBSERVE, PLACE=VVTQ01;
OBSERVE, PLACE=BPHQ2;
