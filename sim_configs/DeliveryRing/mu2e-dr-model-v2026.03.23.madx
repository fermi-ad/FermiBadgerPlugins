G_DQ310 = F_DQ310 * F_SQC * (C0_SQC + C1_SQC * (FI_DQD * I_DQD) + C2_SQC * (FI_DQD * I_DQD)^2 + C3_SQC * (FI_DQD * I_DQD)^3) * E_LIGHT / (1E+09 * L_SQC * E_MOMENTUM);
G_DQ309 = F_DQ309 * F_SQC * (C0_SQC + C1_SQC * (FI_DQF * I_DQF) + C2_SQC * (FI_DQF * I_DQF)^2 + C3_SQC * (FI_DQF * I_DQF)^3) * E_LIGHT / (1E+09 * L_SQC * E_MOMENTUM);
G_DQ308 = F_DQ308 * F_SQC * (C0_SQC + C1_SQC * (FI_DQD * I_DQD - FI_DQS308 * I_DQS308) + C2_SQC * (FI_DQD * I_DQD - FI_DQS308 * I_DQS308)^2 + C3_SQC * (FI_DQD * I_DQD - FI_DQS308 * I_DQS308)^3) * E_LIGHT / (1E+09 * L_SQC * E_MOMENTUM);
G_DQ307 = F_DQ307 * F_SQC * (C0_SQC + C1_SQC * (FI_DQF * I_DQF - FI_DQS307 * I_DQS307) + C2_SQC * (FI_DQF * I_DQF - FI_DQS307 * I_DQS307)^2 + C3_SQC * (FI_DQF * I_DQF - FI_DQS307 * I_DQS307)^3) * E_LIGHT / (1E+09 * L_SQC * E_MOMENTUM);
G_DQ306 = F_DQ306 * F_SQD * (C0_SQD + C1_SQD * (FI_DQD * I_DQD - FI_DQS306 * I_DQS306) + C2_SQD * (FI_DQD * I_DQD - FI_DQS306 * I_DQS306)^2 + C3_SQD * (FI_DQD * I_DQD - FI_DQS306 * I_DQS306)^3) * E_LIGHT / (1E+09 * L_SQD * E_MOMENTUM);
G_DQ305 = F_DQ305 * F_SQD * (C0_SQD + C1_SQD * (FI_DQSS * I_DQSS - FI_DQS305 * I_DQS305) + C2_SQD * (FI_DQSS * I_DQSS - FI_DQS305 * I_DQS305)^2 + C3_SQD * (FI_DQSS * I_DQSS - FI_DQS305 * I_DQS305)^3) * E_LIGHT / (1E+09 * L_SQD * E_MOMENTUM);
G_DQ304 = F_DQ304 * F_SQC * (C0_SQC + C1_SQC * (FI_DQSS * I_DQSS - FI_DQS304 * I_DQS304) + C2_SQC * (FI_DQSS * I_DQSS - FI_DQS304 * I_DQS304)^2 + C3_SQC * (FI_DQSS * I_DQSS - FI_DQS304 * I_DQS304)^3) * E_LIGHT / (1E+09 * L_SQC * E_MOMENTUM);

// Tune ramping and skew quadrupole magnet normalized gradients. [1/m^2]
G_DQX301 = F_DQX301 * F_CQA * (C0_CQA + C1_CQA * (FI_DQX * I_DQX) + C2_CQA * (FI_DQX * I_DQX)^2 + C3_CQA * (FI_DQX * I_DQX)^3) * E_LIGHT / (1E+09 * L_CQA * E_MOMENTUM);
G_DQS104 = F_DQS104 * F_CQA * (C0_CQA + C1_CQA * (FI_DSQ * I_DSQ) + C2_CQA * (FI_DSQ * I_DSQ)^2 + C3_CQA * (FI_DSQ * I_DSQ)^3) * E_LIGHT / (1E+09 * L_CQA * E_MOMENTUM);
G_DQX601 = F_DQX601 * F_CQA * (C0_CQA + C1_CQA * (FI_DQX * I_DQX) + C2_CQA * (FI_DQX * I_DQX)^2 + C3_CQA * (FI_DQX * I_DQX)^3) * E_LIGHT / (1E+09 * L_CQA * E_MOMENTUM);
G_DQS604 = F_DQS604 * F_CQA * (C0_CQA + C1_CQA * (FI_DSQ * I_DSQ) + C2_CQA * (FI_DSQ * I_DSQ)^2 + C3_CQA * (FI_DSQ * I_DSQ)^3) * E_LIGHT / (1E+09 * L_CQA * E_MOMENTUM);
G_DQX501 = F_DQX501 * F_CQA * (C0_CQA + C1_CQA * (FI_DQX * I_DQX) + C2_CQA * (FI_DQX * I_DQX)^2 + C3_CQA * (FI_DQX * I_DQX)^3) * E_LIGHT / (1E+09 * L_CQA * E_MOMENTUM);

