//##############################################################################
// MADX Beamline Lattice Model
// Mu2e (Delivery Ring)
//##############################################################################
// Notes:
//##############################################################################

// Environment commands.
OPTION, ECHO = FALSE;
OPTION, VERIFY = TRUE;
OPTION, RBARC = FALSE;

//##############################################################################
// Beam Parameters
//##############################################################################

// Speed of light. [m/s]
E_LIGHT = 299792458;
// Mass of particle. [GeV/c^2]
E_MASS = 0.938272089;
// Charge of particle. [q]
E_CHARGE = 1;
// Number of particles per bunch. [1]
E_PARTICLES = 1E+12;
// Number of bunches. [1]
E_BUNCHES = 1;
// Beam momentum. [GeV/c]
E_MOMENTUM = 8.847;
// Beam geometric 15% emittances. [m]
E_ET = 0.02;
E_EX = 2E-07;
E_EY = 2E-07;
// Beam relative energy spread. [1]
E_SIGE = 0.001596;
// Beam bunch length. [m]
E_SIGT = 12.46;
// RF frequency. [Hz]
E_DRFN = 2359888;
// RF frequency deviation. [Hz]
E_DRFD = 0;
// RF phase. [2*pi*rad]
E_DRFP = 0.5;
// RF voltage. [kV]
E_DRFV = 10;
// Initial lattice functions. [m | 1]
