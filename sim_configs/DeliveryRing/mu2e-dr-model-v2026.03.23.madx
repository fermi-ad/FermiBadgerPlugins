//##############################################################################
// Main Commands
//##############################################################################

// Beam and sequence commands.
BEAM, MASS = E_MASS, CHARGE = E_CHARGE, PC = E_MOMENTUM, ET = E_ET, EX = E_EX, EY = E_EY, SIGE = E_SIGE, SIGT = E_SIGT, NPART = E_PARTICLES, KBUNCH = E_BUNCHES;
USE, SEQUENCE = FULL;
SHOW, BEAM;

// Twiss table commands.
SIG_X := SQRT(E_EX * TABLE(TWISS, BETX) + (E_SIGE)^2 * (TABLE(TWISS, DX))^2);
SIG_Y := SQRT(E_EY * TABLE(TWISS, BETY) + (E_SIGE)^2 * (TABLE(TWISS, DY))^2);
SELECT, FLAG = TWISS, COLUMN = NAME, KEYWORD, S, BETX, BETY, DX, DY, ALFX, ALFY, DPX, DPY, MUX, MUY, SIG_X, SIG_Y, L, TILT, ANGLE, HKICK, K1L, K2L, K3L;
!TWISS, CENTRE = TRUE, BETX = E_BX0, BETY = E_BY0, DX = E_DX0, DY = E_DY0, ALFX = E_AX0, ALFY = E_AY0, DPX = E_DPX0, DPY = E_DPY0;
TWISS, CENTRE = TRUE;

// Survey table commands.
SELECT, FLAG = SURVEY, COLUMN = NAME, KEYWORD, S, X, Y, Z, THETA, PHI, PSI, L, TILT, ANGLE;
SURVEY, X0 = E_X0, Y0 = E_Y0, Z0 = E_Z0, THETA0 = E_THETA0, PHI0 = E_PHI0, PSI0 = E_PSI0;

// Emit table commands.
!BEAM, RADIATE = TRUE;
!EMIT, DELTAP = 0;
!SHOW, BEAM;

// Output commands.
TITLE, "Mu2e (Delivery Ring)";
SET, FORMAT = "18d", "18.8f", "-18s";
!WRITE, TABLE = SURVEY, FILE = "mu2e-dr-survey-madx.tfs";
!WRITE, TABLE = TWISS, FILE = "mu2e-dr-twiss-madx.tfs";
!PLOT, TABLE = SURVEY, NOVERSION = TRUE, COLOUR = 100, HAXIS = Z, VAXIS = X, FILE = "mu2e-dr-plots-madx";
!PLOT, TABLE = TWISS, NOVERSION = TRUE, COLOUR = 100, HAXIS = S, VAXIS = BETX, BETY, FILE = "mu2e-dr-plots-madx";
!PLOT, TABLE = TWISS, NOVERSION = TRUE, COLOUR = 100, HAXIS = S, VAXIS = DX, DY, FILE = "mu2e-dr-plots-madx";
!PLOT, TABLE = TWISS, NOVERSION = TRUE, COLOUR = 100, HAXIS = S, VAXIS = SIG_X, SIG_Y, FILE = "mu2e-dr-plots-madx";

EXIT;

